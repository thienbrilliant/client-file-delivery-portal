generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role { ADMIN CUSTOMER }
enum ProjectStatus { DRAFT IN_PROGRESS READY ARCHIVED }
enum DeliveryStatus { PREPARING READY VIEWED DOWNLOADED EXPIRED LOCKED COMPLETED }
enum NotificationType { DELIVERY_READY FILE_DOWNLOADED FILE_UPLOADED PROJECT_UPDATED SYSTEM }

model User {
  id String @id @default(cuid())
  email String @unique
  emailVerified DateTime?
  passwordHash String?
  name String?
  avatarUrl String?
  role Role @default(CUSTOMER)
  customerProfile CustomerProfile?
  projectsOwned Project[] @relation("ProjectCustomer")
  filesUploaded File[] @relation("FileUploader")
  downloadLogs DownloadLog[]
  activities ActivityLog[]
  notifications Notification[]
  accounts Account[]
  sessions Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role])
  @@index([createdAt])
}
model CustomerProfile {
  id String @id @default(cuid())
  userId String @unique
  companyName String?
  phone String?
  notes String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Project {
  id String @id @default(cuid())
  customerId String
  name String
  description String?
  status ProjectStatus @default(DRAFT)
  customer User @relation("ProjectCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  folders Folder[]
  files File[]
  deliveries Delivery[]
  activities ActivityLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}
model Folder {
  id String @id @default(cuid())
  projectId String
  parentId String?
  name String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent Folder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  files File[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
  @@index([parentId])
}
model File {
  id String @id @default(cuid())
  projectId String
  folderId String?
  originalName String
  storedName String
  mimeType String
  size BigInt
  storageKey String @unique
  checksum String?
  uploadedById String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  deliveryFiles DeliveryFile[]
  downloadLogs DownloadLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
  @@index([folderId])
  @@index([uploadedById])
  @@index([createdAt])
}
model Delivery {
  id String @id @default(cuid())
  projectId String
  title String
  description String?
  status DeliveryStatus @default(PREPARING)
  expiresAt DateTime?
  allowCustomerUpload Boolean @default(false)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files DeliveryFile[]
  shareLinks ShareLink[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}
model DeliveryFile {
  id String @id @default(cuid())
  deliveryId String
  fileId String
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  @@unique([deliveryId, fileId])
  @@index([deliveryId])
  @@index([fileId])
}
model ShareLink {
  id String @id @default(cuid())
  deliveryId String
  tokenHash String @unique
  passwordHash String?
  expiresAt DateTime?
  maxDownloads Int?
  downloadCount Int @default(0)
  isActive Boolean @default(true)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  downloadLogs DownloadLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([deliveryId])
  @@index([expiresAt])
  @@index([isActive])
}
model DownloadLog {
  id String @id @default(cuid())
  fileId String
  userId String?
  shareLinkId String?
  ipAddress String?
  userAgent String?
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([fileId])
  @@index([userId])
  @@index([shareLinkId])
  @@index([createdAt])
}
model ActivityLog {
  id String @id @default(cuid())
  userId String?
  projectId String?
  action String
  metadata Json?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  message String
  isRead Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, isRead])
  @@index([createdAt])
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}
model Session {
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
