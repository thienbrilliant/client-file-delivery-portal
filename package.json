{
  "name": "client-file-delivery-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "prisma generate",
    "start": "node scripts/validate-env.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:repair-session-drift": "tsx scripts/repair-session-drift.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1098.0",
    "@aws-sdk/s3-request-presigner": "3.1098.0",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "redis": "6.1.0",
    "zod": "4.4.3",
    "@prisma/adapter-pg": "7.9.1",
    "pg": "8.16.3",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "27.0.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "7.9.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.5",
    "vitest": "4.1.10",
    "@types/pg": "8.15.5",
    "dotenv": "17.2.3"
